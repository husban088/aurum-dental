# Vercel -> Project -> Settings -> Environment Variables (add these two, tick Production + Preview + Development)

# MongoDB Atlas connection string (database name /aurum at the end is important)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aurum?retryWrites=true&w=majority

# Any long random string (used to sign login tokens)
JWT_SECRET=<long-random-string>
